# ==========================================================================
# 元データ・中間生成物・巨大ファイルは追跡しない
#   ・基盤地図情報(GSI)のZIPは国土地理院の利用規約があり再配布に注意が必要
#   ・parquet類はスクリプトで再生成できる（README参照）
# ==========================================================================

# 元データ（GSI 基盤地図情報のZIP。DEM含む）
*.zip
20_external/
../*.zip
dataSet/

# 中間・成果データ（再生成可能）
00_raw/
01_interim/
02_processed/
03_network/

# 失敗した書き込みの残骸
*.tmp
*.old
*.stale
*.tmp.npy

# 可視化の重い中間物（PNG/HTMLの最終成果は別途 !: で許可する）
reports/maps/_*/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# ==========================================================================
# ただし成果物として残すもの（除外ルールより後に書いて上書き許可）
# ==========================================================================
!reports/maps/
!reports/maps/*.html
!reports/maps/*.png
